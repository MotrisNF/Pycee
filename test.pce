obj yo{
    func create(x, y){
        self.x = x;
        self.y = y;
    }

    func move(h, y){
        self.x += h;
        self.y += y;
    }
}


prog main(){
    var patata = yo(30,7);
    print(f"patata {patata.type()}");
    var grid = [["."] * 8 for (_ in range(8))];
    for (line in grid){
        print(line);
    }
    print(patata.x);
    patata.move(5, 9);
    print(patata.x);
    try{
        var pataton = num("hola");
    }
    except ValueError(e){
        print(e);
        print(e.type());
        return (1);
    }
}