# Module math: constants, the functions that are number methods, floats, ints, and their errors.
import math;
from math import pi, e, tau, inf, nan;
prog main() {
    print(pi, e, tau, inf, nan, -inf);
    print(math.sqrt(16), math.abs(-3), math.abs(-2.5), math.round(2.5), math.round(-2.5), math.floor(-1.5), math.ceil(1.2), math.trunc(-2.7));
    print(math.round(3.14159, 2), 3.14159.round(3), math.round(1234.5, -2), math.round(0.125, 2), math.round(2.675, 2), 7.round(1), 2.7.trunc());
    print(math.pow(2, 10), math.pow(2, -1), math.pow(2.0, 3));
    print(math.exp(1), math.log(math.e), math.log(8, 2), math.log2(1024), math.log10(1000));
    print(math.sin(0), math.cos(0), math.atan2(1, 1), math.hypot(3, 4), math.degrees(pi), math.radians(180));
    print(math.gcd(12, 18), math.gcd(-12, 18, 30), math.gcd(0, 0), math.lcm(4, 6), math.lcm(4, 6, 10), math.lcm(0, 5));
    print(math.factorial(0), math.factorial(5), math.factorial(20));
    print(math.is_nan(nan), math.is_nan(1), math.is_inf(-inf), math.is_inf(3), math.is_finite(3), math.is_finite(inf));
    print(math.sqrt(inf), math.sin(nan));
    var tries = [
        () => math.sqrt(-1), () => math.log(0), () => math.log(-1), () => math.log(2, 1), () => math.asin(2),
        () => math.exp(1000), () => math.factorial(21), () => math.factorial(-1), () => math.factorial(2.0),
        () => math.lcm(9223372036854775807, 2), () => math.gcd(1.5, 2), () => math.sqrt("4"), () => math.sin(true),
        () => math.round(2.5, 1.0), () => math.round(2.5, "x"), () => math.pow(0, -1), () => math.sin(inf),
        () => math.pow(10.0, 400), () => math.cosh(1000), () => math.abs(-9223372036854775807 - 1),
        () => math.floor(inf), () => math.gcd(-9223372036854775807 - 1, 0)
    ];
    for (t in tries) {
        try { print(t()); } except (err) { print(err); }
    }
    print([2.25, 9, 0.0].map(math.sqrt));
    print([math.round(x, 2) for (x in [1.005, 0.125, -0.125, 2.675, 1.115])]);
    print(2.5.round(), (-2.5).round(0), 2.7.trunc(), (-2.7).trunc(), 9.trunc(), 10.0.pow(2));
    try {
        10.0.pow(400);
    } except OverflowError (err) {
        print(err);
    }
}
