# Lists: literals, indexes, slices, l[i] = x, l[i] += x, += in place, + * is in, var l[n], unpacking, ...l, a list inside itself
func total(...n) { var s = 0; for (x in n) { s += x; } return s; }
prog main() {
    var l = [1, "two", [3, 4], tuple(5)];
    print(l, l[0], l[-1], l[2][1], l[1:3], l[::-1], [], l.type());
    l[0] = 100;
    l[2][0] += 30;
    print(l);
    var m = [1, 2];
    var alias = m;
    m += [3, 4];
    print(m, alias, m is alias, [1, 2] + [3], [0] * 3, 2 * ["a"], [1, [2]] is [1, [2]], 3 in m, 9 not in m);
    var a, b = [10, 20];
    a, m[0] = m[0], a;
    print(a, b, m);
    var z[3];
    print(z, total(...[1, 2, 3]));
    var s = [1];
    s[0] = s;
    print(s);
    for (x in [1, 2, 3]) { print(x); }
}
