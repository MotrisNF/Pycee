# Tuples: build, show, index (negative too), len, for, in / not in, equality, unpacking
var t = tuple(1, "two", 3.5, tuple(4, 5));
var a, b = 10, 20;
prog main() {
    print(t, t.len(), t.type(), tuple(), tuple(tuple()));
    print(t[0], t[-1], t[-1][1], t[1]);
    for (x in t) { print(x); }
    print(2 in tuple(1, 2), 7 not in tuple(1, 2), "two" in t, tuple(4, 5) in t);
    print(4 in range(0, 10, 2), 5 in range(0, 10, 2), 4.0 in range(10), -3 in range(0, -10, -3));
    print(tuple(1, 2) is tuple(1.0, 2), tuple(1) is tuple(1, 2), tuple() is tuple());
    vemp p, q, r = t[3][0], t[3][1], a;
    print(p, q, r);
    var x, y = tuple("x", "y");
    print(x, y);
    a, b = b, a;
    print(a, b);
    x, y = tuple(1, 2);
    print(x, y);
    const C1, C2 = 1, 2;
    print(C1 + C2);
}
