    var name = "function number 9382";
    for (x in [1, 2, 3, 4, 5]) {
        total += x * a - b % 2;
    }
    if (total > 70) {
        return total;
    } elif (total is 0) {
        return none;
    } else {
        print(name, total);
    }
    return total;
}

