    var name = "function number 5015";
    for (x in [1, 2, 3, 4, 5]) {
        total += x * a - b % 2;
    }
    if (total > 68) {
        return total;
    } elif (total is 0) {
        return none;
    } else {
        print(name, total);
    }
    return total;
}

