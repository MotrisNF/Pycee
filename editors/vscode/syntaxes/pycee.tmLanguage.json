    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.pycee",
          "match": "\\b0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*\\b"
        },
        {
          "name": "constant.numeric.binary.pycee",
          "match": "\\b0[bB][01](?:_?[01])*\\b"
        },
        {
          "name": "constant.numeric.octal.pycee",
          "match": "\\b0[oO][0-7](?:_?[0-7])*\\b"
        },
        {
          "name": "constant.numeric.float.pycee",
          "match": "\\b\\d(?:_?\\d)*(?:\\.\\d(?:_?\\d)*(?:[eE][-+]?\\d+)?|[eE][-+]?\\d+)\\b"
        },
        {
          "name": "constant.numeric.integer.pycee",
          "match": "\\b\\d(?:_?\\d)*\\b"
        }
      ]
